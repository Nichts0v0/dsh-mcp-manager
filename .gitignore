# ── dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.npm-cache/

# ── build output ───────────────────────────────────────────────────────────────
# lib/ is regenerated by the `prepare`/`build` script (esbuild), so it stays
# out of git. `npm install` runs prepare automatically and rebuilds it.
lib/

